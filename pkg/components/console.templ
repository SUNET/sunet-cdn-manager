templ IPNetworksContent(ipNetworks []cdntypes.IPNetworkListItem, flashMessages []string, errorMessage string) {
	<p class="secondary-text">Networks used for allocating IP addresses to services.</p>
	@flashMessagesComponent(flashMessages)
	if errorMessage != "" {
		<span class="error-text" role="alert" aria-live="polite">{ errorMessage }</span>
	}
	if len(ipNetworks) == 0 {
		<article class="empty-state">
			<p>No IP networks added yet</p>
			<a href="/console/superuser/create/ip-network" role="button">Add your first IP network</a>
		</article>
	} else {
		<table>
			<thead>
				<tr>
					<th>Network</th>
					<th>Family</th>
					<th>Allocated</th>
					<th>Actions</th>
				</tr>
			</thead>
			<tbody>
				for _, n := range ipNetworks {
					<tr>
						<td>{ n.Network.String() }</td>
						<td>{ ipNetworkFamily(n.Network) }</td>
						<td>{ strconv.FormatInt(n.Allocated, 10) }</td>
						<td>
							<button
								type="button"
								hx-delete={ string(templ.URL(fmt.Sprintf("/console/superuser/ip-networks/%s", n.ID.String()))) }
								hx-target="body"
								hx-confirm={ fmt.Sprintf("Are you sure you want to delete '%s'?", n.Network.String()) }
								hx-disabled-elt="this"
								disabled?={ n.Allocated != 0 }
							>
								Delete
							</button>
						</td>
					</tr>
				}
			</tbody>
		</table>
		<p>
			<a href="/console/superuser/create/ip-network" role="button">Add IP network</a>
		</p>
	}
}

