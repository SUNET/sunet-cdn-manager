package components

import (
	"errors"
	"fmt"
	"github.com/SUNET/sunet-cdn-manager/pkg/cdnerrors"
	"github.com/SUNET/sunet-cdn-manager/pkg/cdntypes"
	"github.com/jackc/pgx/v5/pgtype"
	"net/netip"
	"net/url"
	"strconv"
)

// activeAttr is used in the NavBar component to determine which navigation
// link should be marked as active based on the current page URL.
func activeAttr(section string, u *url.URL) templ.Attributes {
	if section == urlToSection(u) {
		return templ.Attributes{"aria-current": "page"}
	}
	return templ.Attributes{}
}

func ipNetworkFamily(prefix netip.Prefix) string {
	if prefix.Addr().Is6() {
		return "IPv6"
	}
	return "IPv4"
}

templ ConsolePage(u *url.URL, title string, ad cdntypes.AuthData, orgName string, availableOrgNames []string, contents templ.Component, itemLabel string) {
	<!DOCTYPE html>
	<html lang="en">
		@consoleHeadComponent(title)
		<body hx-boost="true" hx-indicator="#spinner">
			<div class="console-grid">
				<header>
					<span class="app-name">
						SUNET CDN manager
					</span>
					<span class="place-end">
						if ad.Username != nil {
							{ *ad.Username }
						} else {
							Username missing
						}
						<form id="logout" method="POST" action={ templ.URL(cdntypes.AuthLogoutPath) } hx-boost="false">
							<button type="submit" role="button">Logout</button>
						</form>
					</span>
				</header>
				@NavBar(u, ad, orgName, availableOrgNames)
				<main>
					@breadcrumbNav(buildBreadcrumbs(u, orgName, itemLabel))
					<h1>{ title } <span id="spinner" class="htmx-indicator spinner"></span></h1>
					<div id="contents">
						@contents
					</div>
				</main>
			</div>
		</body>
	</html>
}

templ breadcrumbNav(crumbs []Breadcrumb) {
	if len(crumbs) > 0 {
		<nav aria-label="Breadcrumb" class="breadcrumb">
			<ol>
				for i, crumb := range crumbs {
					<li>
						if i > 0 {
							<span class="breadcrumb-sep" aria-hidden="true">/</span>
						}
						<a href={ templ.URL(crumb.URL) }>{ crumb.Label }</a>
					</li>
				}
			</ol>
		</nav>
	}
}

templ commonHead() {
	<meta charset="UTF-8"/>
	<meta name="viewport" content="width=device-width, initial-scale=1"/>
}

templ consoleHeadComponent(title string) {
	<head>
		@commonHead()
		// Enable htmx
		<script src="/js/dist/htmx/2.0.4/htmx.min.js"></script>
		// Enable _hyperscript
		<script src="/js/dist/_hyperscript/0.9.14/_hyperscript.min.js"></script>
		@picoCssLinks()
		// Configure the grid layout of the console
		<link rel="stylesheet" href="/css/console-grid.css"/>
		<title>{ title }</title>
	</head>
}

templ picoCssLinks() {
	// Enable Pico CSS
	<link rel="stylesheet" href="/css/dist/pico-2.1.1/css/pico.min.css"/>
	// Set some variables for Pico CSS to make things a bit smaller
	// https://github.com/picocss/pico/discussions/482
	<link rel="stylesheet" href="/css/pico-settings.css"/>
}

templ checkboxInput(name string, checked bool, putTarget string, confirmMessage string, ariaLabel string) {
	// hx-confirm cannot be used on <input> because the browser updates
	// the checkbox state before the confirm dialog appears, and cancelling
	// does not restore it. Instead _hyperscript confirms on change, flips back
	// the previous value on cancel, and triggers a custom "confirmed" event.
	<input
		type="checkbox"
		checked?={ checked }
		hx-put={ string(templ.URL(putTarget)) }
		hx-target="body"
		hx-trigger="confirmed"
		data-confirm={ confirmMessage }
		_="on change if confirm(my @data-confirm) trigger confirmed on me else set my checked to not my checked"
		aria-label={ ariaLabel }
		name={ name }
	/>
}

templ selectInput(name string, putTarget string, confirmMessage string, ariaLabel string, selectOptions []selectInputOption) {
	// hx-confirm cannot be used on <select> because the browser updates
	// the displayed value before the confirm dialog appears, and cancelling
	// does not restore it. Instead _hyperscript confirms on change, restores
	// the previous value on cancel, and triggers a custom "confirmed" event.
	<select
		hx-put={ string(templ.URL(putTarget)) }
		hx-target="body"
		hx-trigger="confirmed"
		name={ name }
		data-confirm={ confirmMessage }
		_="on focus set my @data-prev to my value on change set v to my value if v is '' set v to 'none' end set msg to my @data-confirm set msg to msg.replace('{value}', v) if confirm(msg) trigger confirmed on me else set my value to my @data-prev"
		aria-label={ ariaLabel }
	>
		for _, so := range selectOptions {
			<option value={ so.value } selected?={ so.selected }>{ so.content }</option>
		}
	</select>
}

templ Dashboard(dashData cdntypes.DashboardData) {
	if !dashData.ResourceAccess {
		<article class="empty-state">
			<p>You do not have access to any resources</p>
		</article>
	} else {
		if dashData.OrgDashboard {
			<div class="dashboard-grid">
				<article>
					<header><strong>Domains</strong></header>
					<div class="quota-value">{ dashData.DomainUsed }/{ dashData.DomainQuota }</div>
					if dashData.DomainQuota > 0 {
						<progress aria-label="Domain quota" value={ strconv.FormatInt(dashData.DomainUsed, 10) } max={ strconv.FormatInt(dashData.DomainQuota, 10) }></progress>
					}
				</article>
				<article>
					<header><strong>Services</strong></header>
					<div class="quota-value">{ dashData.ServiceUsed }/{ dashData.ServiceQuota }</div>
					if dashData.ServiceQuota > 0 {
						<progress aria-label="Service quota" value={ strconv.FormatInt(dashData.ServiceUsed, 10) } max={ strconv.FormatInt(dashData.ServiceQuota, 10) }></progress>
					}
				</article>
				<article>
					<header><strong>API Tokens</strong></header>
					<div class="quota-value">{ dashData.ClientCredsUsed }/{ dashData.ClientCredsQuota }</div>
					if dashData.ClientCredsQuota > 0 {
						<progress aria-label="API token quota" value={ strconv.FormatInt(dashData.ClientCredsUsed, 10) } max={ strconv.FormatInt(dashData.ClientCredsQuota, 10) }></progress>
					}
				</article>
			</div>
		} else {
			<article class="empty-state">
				<p>Select an organization from the sidebar to manage its resources.</p>
			</article>
		}
	}
}

templ NavBar(u *url.URL, ad cdntypes.AuthData, orgName string, availableOrgNames []string) {
	<div class="sidebar">
		<aside>
			<nav>
				<ul>
					if len(availableOrgNames) != 0 {
						<li>
							<p class="nav-section-label">Organization</p>
							<form hx-get={ templ.URL("/console/org-switcher") } hx-trigger="change" hx-target="body" hx-push-url="true">
								<select name="org">
									if ad.OrgID == nil {
										<option value={ cdntypes.OrgNotSelected } selected>{ cdntypes.OrgNotSelected }</option>
									}
									for _, availableOrgName := range availableOrgNames {
										<option value={ availableOrgName } selected?={ availableOrgName == orgName }>{ availableOrgName }</option>
									}
								</select>
							</form>
						</li>
					}
					if orgName != "" {
						<li>
							<p class="nav-section-label">Management</p>
						</li>
						<li><a href={ templ.URL(fmt.Sprintf("/console/org/%s", orgName)) } { activeAttr("dashboard", u)... }>Dashboard</a></li>
						<li><a href={ templ.URL(fmt.Sprintf("/console/org/%s/domains", orgName)) } { activeAttr("domains", u)... }>Domains</a></li>
						<li><a href={ templ.URL(fmt.Sprintf("/console/org/%s/services", orgName)) } { activeAttr("services", u)... }>Services</a></li>
						<li><a href={ templ.URL(fmt.Sprintf("/console/org/%s/api-tokens", orgName)) } { activeAttr("api-tokens", u)... }>API tokens</a></li>
					}
					if ad.Superuser {
						<li><p class="nav-section-label">Superuser</p></li>
						<li><a href="/console/superuser/orgs" { activeAttr("orgs", u)... }>Organizations</a></li>
						<li><a href="/console/superuser/ip-networks" { activeAttr("ip-networks", u)... }>IP networks</a></li>
						<li><a href="/console/superuser/cache-nodes" { activeAttr("cache-nodes", u)... }>Cache nodes</a></li>
						<li><a href="/console/superuser/l4lb-nodes" { activeAttr("l4lb-nodes", u)... }>L4LB nodes</a></li>
						<li><a href="/console/superuser/node-groups" { activeAttr("node-groups", u)... }>Node groups</a></li>
						<li><a href="/console/superuser/users" { activeAttr("users", u)... }>Users</a></li>
					}
				</ul>
			</nav>
		</aside>
	</div>
}

templ flashMessagesComponent(flashMessages []string) {
	if len(flashMessages) != 0 {
		<div class="flash-container" _="on load transition my opacity to 0 over 5 seconds then remove me">
			for _, flashMessage := range flashMessages {
				<article>
					{ flashMessage }
				</article>
			}
		</div>
	}
}

templ DomainsContent(orgName string, domains []cdntypes.Domain, verificationTag string, tagSeparator string, flashMessages []string, errorMessage string) {
	@flashMessagesComponent(flashMessages)
	if errorMessage != "" {
		<span class="error-text" role="alert" aria-live="polite">{ errorMessage }</span>
	}
	if len(domains) == 0 {
		<article class="empty-state">
			<p>No domains added yet</p>
			<a href={ templ.URL(fmt.Sprintf("/console/org/%s/create/domain", orgName)) } role="button">Add your first domain</a>
		</article>
	} else {
		<table>
			<thead>
				<tr>
					<th>Domain</th>
					<th>Verified</th>
					<th>Verification record</th>
					<th>Actions</th>
				</tr>
			</thead>
			<tbody>
				for _, domain := range domains {
					<tr>
						<td>{ domain.FQDN }</td>
						if domain.Verified {
							<td><span aria-hidden="true">✅ </span>Yes</td>
						} else {
							<td><span aria-hidden="true">⏳ </span>In progress</td>
						}
						<td>{ domain.FQDN }. IN TXT "{ verificationTag }{ tagSeparator }{ domain.VerificationToken }"</td>
						<td>
							<button
								type="button"
								hx-delete={ string(templ.URL(fmt.Sprintf("/console/org/%s/domains/%s", orgName, domain.FQDN))) }
								hx-target="body"
								hx-confirm={ fmt.Sprintf("Are you sure you want to delete '%s'?", domain.FQDN) }
								hx-disabled-elt="this"
							>
								Delete
							</button>
						</td>
					</tr>
				}
			</tbody>
		</table>
		<p>
			<a href={ templ.URL(fmt.Sprintf("/console/org/%s/create/domain", orgName)) } role="button">Add domain</a>
		</p>
	}
}

templ APITokensContent(orgName string, orgClientCreds []cdntypes.OrgClientCredentialSafe, flashMessages []string, tokenURL *url.URL, serverURL *url.URL, errorMessage string) {
	@flashMessagesComponent(flashMessages)
	if errorMessage != "" {
		<span class="error-text" role="alert" aria-live="polite">{ errorMessage }</span>
	}
	if len(orgClientCreds) == 0 {
		<article class="empty-state">
			<p>No API tokens added yet</p>
			<a href={ templ.URL(fmt.Sprintf("/console/org/%s/create/api-token", orgName)) } role="button">Add your first API token</a>
		</article>
	} else {
		<table>
			<thead>
				<tr>
					<th>Name</th>
					<th>Client ID</th>
					<th>Actions</th>
				</tr>
			</thead>
			<tbody>
				for _, orgClientCred := range orgClientCreds {
					<tr>
						<td>{ orgClientCred.Name }</td>
						<td>{ orgClientCred.ClientID }</td>
						<td>
							<button
								type="button"
								hx-delete={ string(templ.URL(fmt.Sprintf("/console/org/%s/api-tokens/%s", orgName, orgClientCred.Name))) }
								hx-target="body"
								hx-confirm={ fmt.Sprintf("Are you sure you want to delete '%s'?", orgClientCred.Name) }
								hx-disabled-elt="this"
							>
								Delete
							</button>
						</td>
					</tr>
				}
			</tbody>
		</table>
		<p>
			<a href={ templ.URL(fmt.Sprintf("/console/org/%s/create/api-token", orgName)) } role="button">Add API token</a>
		</p>
	}
	<div>
		<p>To get an access token for use with the API:</p>
		<pre>
			<code>
				{ tokenCurlCommand(tokenURL) }
			</code>
		</pre>
		<p>To use the access token to list existing API tokens:</p>
		<pre>
			<code>
				{ apiSampleCurlCommand(serverURL, orgName) }
			</code>
		</pre>
	</div>
}

templ ServicesContent(orgName string, services []ServiceEntry, superuser bool, serviceQuota int64, flashMessages []string, errorMessage string) {
	@flashMessagesComponent(flashMessages)
	if errorMessage != "" {
		<span class="error-text" role="alert" aria-live="polite">{ errorMessage }</span>
	}
	if len(services) == 0 {
		<article class="empty-state">
			<p>No services created yet</p>
			<a href={ templ.URL(fmt.Sprintf("/console/org/%s/create/service", orgName)) } role="button">Create your first service</a>
		</article>
	} else {
		<p class="quota-usage">
			{ strconv.Itoa(len(services)) } of { strconv.FormatInt(serviceQuota, 10) } services used
			if disabledServiceCount(services) > 0 {
				({ strconv.Itoa(disabledServiceCount(services)) } disabled)
			}
		</p>
		<table>
			<thead>
				<tr>
					<th>Service</th>
					<th>State</th>
					<th>IP Addresses</th>
					<th>Actions</th>
				</tr>
			</thead>
			<tbody>
				for _, service := range services {
					<tr>
						<td class="name"><a href={ templ.URL(fmt.Sprintf("/console/org/%s/services/%s", service.OrgName, service.Name)) }>{ service.Name }</a></td>
						<td class="state">
							if service.TimeDisabled == nil {
								Enabled
							} else {
								Disabled { service.TimeDisabled.Format("2006-01-02") }
							}
						</td>
						<td class="addresses">
							if len(service.IPAddresses) == 0 {
								—
							} else {
								for _, addr := range service.IPAddresses {
									<div><code>{ addr.String() }</code></div>
								}
							}
						</td>
						<td class="actions">
							// Every action here addresses the service by UUID rather than by
							// name, because this page can be stale: if the service is deleted
							// and a new one created reusing the name after the page was
							// rendered, a name-keyed link acts on the replacement instead.
							//
							// Disable and Delete lead to a confirmation page rather than acting
							// directly, so they need the UUID just as much as the Enable POST
							// does: reaching the wrong confirmation page is how the user is
							// deceived into confirming the wrong thing.
							if service.TimeDisabled == nil {
								<a href={ templ.URL(fmt.Sprintf("/console/org/%s/services/%s/disable", service.OrgName, service.ID.String())) } role="button">Disable</a>
							} else {
								<button
									type="button"
									hx-post={ string(templ.URL(fmt.Sprintf("/console/org/%s/services/%s/enable", service.OrgName, service.ID.String()))) }
									hx-target="body"
									hx-confirm={ fmt.Sprintf("Enable '%s'? The service starts again with an empty cache and may be briefly unavailable while cache nodes start.", service.Name) }
									hx-disabled-elt="this"
								>
									Enable
								</button>
								if superuser {
									<a href={ templ.URL(fmt.Sprintf("/console/org/%s/services/%s/delete", service.OrgName, service.ID.String())) } role="button" class="destructive">Delete</a>
								} else {
									// Rendered greyed out rather than hidden: a missing
									// button reads as an absent feature, a disabled one
									// reads as a policy.
									<button type="button" class="destructive" disabled aria-disabled="true" title="Deleting a service requires superuser access">Delete</button>
									<small>Requires superuser access</small>
								}
							}
						</td>
					</tr>
				}
			</tbody>
		</table>
		<p>
			<a href={ templ.URL(fmt.Sprintf("/console/org/%s/create/service", orgName)) } role="button">Create service</a>
		</p>
	}
}

templ DeleteServiceContent(orgName string, serviceName string, serviceID string, versionCount int64, ipAddresses []netip.Addr, uidRangeFirst int64, uidRangeLast int64, err error) {
	<div>
		<p>
			You are about to <strong>permanently delete</strong> the disabled service
			<strong>{ serviceName }</strong>. This cannot be undone.
		</p>
		<p>The following will be destroyed:</p>
		<ul>
			<li>{ strconv.FormatInt(versionCount, 10) } service version(s), with their origins, domain bindings and VCL</li>
			if len(ipAddresses) > 0 {
				<li>
					These IP addresses, released for reallocation to other services:
					for _, addr := range ipAddresses {
						<div><code>{ addr.String() }</code></div>
					}
				</li>
			}
			<li>The UID range { strconv.FormatInt(uidRangeFirst, 10) }–{ strconv.FormatInt(uidRangeLast, 10) }</li>
		</ul>
		<p>Type the service name to confirm.</p>
	</div>
	// The action targets the service's immutable UUID, not its name. Service
	// names are unique per org only at a given moment: deleting a service
	// frees its name for reuse, so a stale copy of this page submitted after
	// the service was deleted and a same-named replacement created would have
	// deleted the replacement.
	<form method="post" action={ templ.URL(fmt.Sprintf("/console/org/%s/services/%s/delete", orgName, serviceID)) } hx-disabled-elt="find button[type='submit']">
		<label for="confirm-name">
			Service name
			<input type="text" id="confirm-name" name="confirm-name" autocomplete="off" required/>
		</label>
		<button type="submit" class="destructive">Delete service permanently</button>
		<a href={ templ.URL(fmt.Sprintf("/console/org/%s/services", orgName)) } role="button" class="secondary">Cancel</a>
	</form>
	if err != nil {
		switch  {
			case errors.Is(err, cdnerrors.ErrConfirmNameMismatch):
				<div class="error-text" role="alert">The service name did not match. Nothing was deleted.</div>
			case errors.Is(err, cdnerrors.ErrServiceNotDisabled):
				<div class="error-text" role="alert">This service must be disabled before it can be deleted. Disable it first, then delete it.</div>
			default:
				<div class="error-text" role="alert">Something went wrong and the service was not deleted.</div>
		}
	}
}

// ServiceContent takes the service UUID rather than its name because the
// create-version links below are mutating: a version created through them is
// attached to whatever the path segment resolves to. Keying on the name means
// a service deleted and recreated under that name while this page sits open
// receives a version meant for its predecessor, silently. The form behind
// these links takes minutes to fill in, so that window is wide.
templ ServiceContent(orgName string, serviceID pgtype.UUID, serviceVersions []cdntypes.ServiceVersion) {
	if len(serviceVersions) == 0 {
		<article class="empty-state">
			<p>No versions created yet</p>
			<a href={ templ.URL(fmt.Sprintf("/console/org/%s/create/service/version/%s", orgName, serviceID.String())) } role="button">Create your first version</a>
		</article>
	} else {
		<table>
			<thead>
				<tr>
					<th>Version</th>
					<th>Active</th>
					<th>Description</th>
					<th>Actions</th>
				</tr>
			</thead>
			<tbody>
				// Print versions starting with the latest version
				for i := len(serviceVersions)-1; i >= 0; i-- {
					{{ sv := serviceVersions[i] }}
					<tr>
						<td>
							<a href={ templ.URL(fmt.Sprintf("/console/org/%s/services/%s/%d", sv.OrgName, sv.ServiceName, sv.Version)) }>{ strconv.FormatInt(sv.Version, 10) }</a>
						</td>
						<td>
							if sv.Active {
								<span aria-hidden="true">✅ </span>Yes
							} else {
								<span aria-hidden="true">❌ </span>No
							}
						</td>
						<td>{ sv.Description }</td>
						<td>
							<button
								type="button"
								hx-get={ string(templ.URL(fmt.Sprintf("/console/org/%s/services/%s/%d/activate", sv.OrgName, serviceID.String(), sv.Version))) }
								hx-target="body"
								disabled?={ sv.Active }
								hx-disabled-elt="this"
							>
								Activate
							</button>
							<button
								type="button"
								hx-get={ string(templ.URL(fmt.Sprintf("/console/org/%s/create/service/version/%s?clone-version=%d", orgName, serviceID.String(), sv.Version))) }
								hx-target="body"
								hx-push-url="true"
							>
								Clone
							</button>
						</td>
					</tr>
				}
			</tbody>
		</table>
		<p>
			<a href={ templ.URL(fmt.Sprintf("/console/org/%s/create/service/version/%s", orgName, serviceID.String())) } role="button">Create service version</a>
		</p>
	}
}

templ CreateDomainContent(orgName string, dData DomainData) {
	if dData.Errors.ServerError != "" {
		<span class="error-text" role="alert" aria-live="polite">{ dData.Errors.ServerError }</span>
	}
	<form method="post" action={ templ.URL(fmt.Sprintf("/console/org/%s/create/domain", orgName)) } hx-disabled-elt="find button[type='submit']">
		<label for="fqdn">
			FQDN
			<input type="text" id="fqdn" name="fqdn" placeholder="Enter domain name..." value={ dData.FQDN } required/>
		</label>
		<span class="error-text">{ dData.Errors.FQDN }</span>
		<button type="submit">Add domain</button>
	</form>
}

templ CreateAPITokenContent(orgName string, atData APITokenData) {
	if atData.Errors.ServerError != "" {
		<span class="error-text" role="alert" aria-live="polite">{ atData.Errors.ServerError }</span>
	}
	<form method="post" action={ templ.URL(fmt.Sprintf("/console/org/%s/create/api-token", orgName)) } hx-disabled-elt="find button[type='submit']">
		<label for="name">
			Name
			<input type="text" id="name" name="name" placeholder="Enter API token name..." value={ atData.Name } required/>
		</label>
		<label for="description">
			Description
			<input type="text" id="description" name="description" placeholder="Enter a description..." value={ atData.Description } required/>
		</label>
		<span class="error-text">{ atData.Errors.Name }</span>
		<span class="error-text">{ atData.Errors.Description }</span>
		<button type="submit">Add API token</button>
	</form>
}

templ NewAPITokenContent(orgName string, newOrgCred cdntypes.NewOrgClientCredential, returnURL string) {
	<article>
		<header>Details for new API token "{ newOrgCred.Name }"</header>
		<p>Client ID:</p>
		<pre><code>{ newOrgCred.ClientID }</code></pre>
		<p>Client secret (will only be shown once):</p>
		<pre><code id="api-secret">{ newOrgCred.ClientSecret }</code></pre>
		<button
			type="button"
			_="on click
              writeText(#api-secret's textContent) into the navigator's clipboard
              then put 'Copied!' into me
              then wait 2s
              then put 'Copy Secret' into me"
		>
			Copy Secret
		</button>
		<footer>
			<button type="button" hx-get={ returnURL } hx-target="body" class="secondary" hx-push-url="true">
				Done
			</button>
		</footer>
	</article>
}

templ CreateServiceContent(orgName string, err error) {
	if err != nil {
		<article id="error-message" aria-label="Error" role="alert">
			switch  {
				case errors.Is(err, cdnerrors.ErrAlreadyExists):
					<div><strong>Error:</strong> Service already exists</div>
				case errors.Is(err, cdnerrors.ErrInvalidFormData):
					<div><strong>Error:</strong> Invalid form data</div>
				case errors.Is(err, cdnerrors.ErrNoServiceIPAddresses):
					<div><strong>Error:</strong> { ipAllocationErrMsg(err) }</div>
				default:
					<div><strong>Error:</strong> Service creation failed</div>
			}
		</article>
	}
	<form method="post" action={ templ.URL(fmt.Sprintf("/console/org/%s/create/service", orgName)) } hx-disabled-elt="find button[type='submit']">
		<label for="name">
			Name
			<input type="text" id="name" name="name" placeholder="Enter service name, e.g. my-service-1..." required/>
		</label>
		<button type="submit">Add service</button>
	</form>
}

templ ServiceVersionContent(serviceName string, sv cdntypes.ServiceVersionConfig) {
	<article>
		<header>
			<strong>Version details</strong>
		</header>
		<table>
			<tr>
				<th scope="row">Version</th>
				<td>{ strconv.FormatInt(sv.Version, 10) }</td>
			</tr>
			<tr>
				<th scope="row">Active</th>
				<td>
					if sv.Active {
						<span aria-hidden="true">✅ </span>Yes
					} else {
						<span aria-hidden="true">❌ </span>No
					}
				</td>
			</tr>
			<tr>
				<th scope="row">Description</th>
				<td>{ sv.Description }</td>
			</tr>
		</table>
	</article>
	<article>
		<header>
			<strong>Origin groups</strong>
		</header>
		if len(sv.OriginGroups) == 0 {
			<p>No origin groups configured</p>
		} else {
			// Groups arrive ordered by position, so conditional groups are
			// listed in the order their conditions are evaluated, with the
			// default group last.
			for _, originGroup := range sv.OriginGroups {
				<section>
					<h4>
						{ originGroup.Name }
						if originGroup.DefaultGroup {
							<small>(default group — used when no condition matches)</small>
						}
					</h4>
					if originGroup.Condition != nil {
						<p>Condition:</p>
						<pre class="vcl-preview"><code>{ *originGroup.Condition }</code></pre>
					}
					{{ groupOrigins := originsForGroup(sv.Origins, originGroup.ID) }}
					if len(groupOrigins) == 0 {
						<p>No origins in this group</p>
					} else {
						<table>
							<thead>
								<tr>
									<th scope="col">Host</th>
									<th scope="col">Port</th>
									<th scope="col">TLS</th>
									<th scope="col">Verify TLS</th>
								</tr>
							</thead>
							<tbody>
								for _, origin := range groupOrigins {
									<tr>
										<td>{ origin.Host }</td>
										<td>{ strconv.Itoa(origin.Port) }</td>
										<td>
											if origin.TLS {
												<span aria-hidden="true">✅ </span>Enabled
											} else {
												<span aria-hidden="true">❌ </span>Disabled
											}
										</td>
										<td>
											if origin.VerifyTLS {
												<span aria-hidden="true">✅ </span>Enabled
											} else {
												<span aria-hidden="true">❌ </span>Disabled
											}
										</td>
									</tr>
								}
							</tbody>
						</table>
					}
				</section>
			}
		}
	</article>
	<article>
		<header>
			<strong>Domains</strong>
		</header>
		if len(sv.Domains) == 0 {
			<p>No domains configured</p>
		} else {
			<ul>
				for _, domain := range sv.Domains {
					<li>{ domain.String() }</li>
				}
			</ul>
		}
	</article>
	if sv.VCLTemplate != "" {
		<article>
			<details>
				<summary><strong>VCL template</strong></summary>
				<pre class="vcl-preview"><code>{ sv.VCLTemplate }</code></pre>
			</details>
		</article>
	}
}

// OriginFieldSet renders the host/port/tls/verify-tls fields for a single
// origin. namePrefix is the dotted path of the origin's containing group
// (e.g. "conditional-origin-groups.0.origins" or
// "default-origin-group.origins") and index is this origin's position
// within that group. numFields is the total number of origins currently in
// the group, used only to decide the initial (pre-JS) disabled state of the
// "Remove origin" button, since a group must always keep at least one
// origin (server-side validation requires min=1); after any add/remove this
// is re-derived live by the manager:formchanged handler in
// CreateServiceVersionContent.
templ OriginFieldSet(namePrefix string, index int, numFields int, submittedOrigin *cdntypes.CreateServiceVersionOrigin, cloneOrigin cdntypes.Origin) {
	<article class="origin-fieldset">
		<fieldset>
			<legend>Origin</legend>
			<label for={ fmt.Sprintf("%s.%d.host", namePrefix, index) }>
				{{
					host := ""
					if submittedOrigin != nil {
						host = submittedOrigin.OriginHost
					} else if cloneOrigin.Host != "" {
						host = cloneOrigin.Host
					}
				}}
				Host
				<input type="text" id={ fmt.Sprintf("%s.%d.host", namePrefix, index) } name={ fmt.Sprintf("%s.%d.host", namePrefix, index) } value={ host } required/>
			</label>
			<label for={ fmt.Sprintf("%s.%d.port", namePrefix, index) }>
				{{
					originPortStr := ""
					if submittedOrigin != nil && submittedOrigin.OriginPort != 0 {
						originPortStr = strconv.Itoa(submittedOrigin.OriginPort)
					} else if cloneOrigin.Port != 0 {
						originPortStr = strconv.Itoa(cloneOrigin.Port)
					}
				}}
				Port
				<input type="number" id={ fmt.Sprintf("%s.%d.port", namePrefix, index) } name={ fmt.Sprintf("%s.%d.port", namePrefix, index) } value={ originPortStr } min="1" max="65535" step="1" inputmode="numeric" required/>
			</label>
			<label for={ fmt.Sprintf("%s.%d.tls", namePrefix, index) }>
				{{
					var tlsChecked bool
					if submittedOrigin != nil {
						tlsChecked = submittedOrigin.OriginTLS
					} else {
						tlsChecked = cloneOrigin.TLS
					}
				}}
				TLS
				<input type="checkbox" id={ fmt.Sprintf("%s.%d.tls", namePrefix, index) } name={ fmt.Sprintf("%s.%d.tls", namePrefix, index) } checked?={ tlsChecked }/>
			</label>
			<label for={ fmt.Sprintf("%s.%d.verify-tls", namePrefix, index) }>
				{{
					var verifyTLSChecked bool
					if submittedOrigin != nil {
						verifyTLSChecked = submittedOrigin.OriginVerifyTLS
					} else {
						verifyTLSChecked = cloneOrigin.VerifyTLS
					}
				}}
				Verify TLS
				<input type="checkbox" id={ fmt.Sprintf("%s.%d.verify-tls", namePrefix, index) } name={ fmt.Sprintf("%s.%d.verify-tls", namePrefix, index) } checked?={ verifyTLSChecked }/>
			</label>
		</fieldset>
		<button
			type="button"
			class="remove-origin-button"
			disabled?={ numFields == 1 }
			_="on click remove closest <article.origin-fieldset/> then send manager:formchanged to #origin-group-fieldsets"
		>
			Remove origin
		</button>
	</article>
}

// addGroupOriginButton renders the "Add origin" button for a conditional
// origin group. The group index is read from the enclosing
// article.origin-group's data-group-index attribute at click time (rather
// than baked in at render time) because that index can change afterwards
// due to add/remove/move of other groups; manager:formchanged keeps
// data-group-index in sync with DOM order.
templ addGroupOriginButton(orgName string, serviceName string) {
	<button
		type="button"
		class="add-origin-button"
		hx-get="/console/new-origin-fieldset"
		hx-target="previous .group-origins"
		hx-swap="beforeend"
		hx-vals={ jsonAddButtonVals(orgName, serviceName) }
		hx-disabled-elt="this"
		_="on htmx:configRequest(detail)
			set detail.parameters['group'] to closest @data-group-index
			set detail.parameters['next-origin-index'] to ((previous .group-origins from me).children.length)"
	>
		Add origin
	</button>
}

// addDefaultGroupOriginButton is the default-origin-group equivalent of
// addGroupOriginButton. The default group's server-side identity ("default")
// never changes, so its "group" hx-vals parameter can be a static value
// instead of being computed at click time.
templ addDefaultGroupOriginButton(orgName string, serviceName string) {
	<button
		type="button"
		class="add-origin-button"
		hx-get="/console/new-origin-fieldset"
		hx-target="previous .group-origins"
		hx-swap="beforeend"
		hx-disabled-elt="this"
		hx-vals={ jsonAddOriginButtonVals(orgName, serviceName, cdntypes.DefaultOriginGroupName) }
		_="on htmx:configRequest(detail)
			set detail.parameters['next-origin-index'] to ((previous .group-origins from me).children.length)"
	>
		Add origin
	</button>
}

// OriginGroupFieldSet renders one conditional origin group: its name,
// condition expression and nested origins, plus move/remove controls.
// isLast tells the initial (pre-JS) render whether to disable the "Move
// down" button; like numFields on OriginFieldSet this is re-derived live by
// manager:formchanged after any DOM change.
templ OriginGroupFieldSet(orgName string, serviceName string, groupIndex int, isLast bool, submittedGroup *cdntypes.CreateServiceVersionConditionalGroup, cloneGroup *cdntypes.OriginGroup, cloneOrigins []cdntypes.Origin) {
	{{ originsNamePrefix := fmt.Sprintf("conditional-origin-groups.%d.origins", groupIndex) }}
	<article class="origin-group" data-group-index={ strconv.Itoa(groupIndex) }>
		<fieldset>
			<legend>Origin group</legend>
			<label for={ fmt.Sprintf("conditional-origin-groups.%d.name", groupIndex) }>
				{{
					name := ""
					if submittedGroup != nil {
						name = submittedGroup.Name
					} else if cloneGroup != nil {
						name = cloneGroup.Name
					}
				}}
				Name
				<input type="text" id={ fmt.Sprintf("conditional-origin-groups.%d.name", groupIndex) } name={ fmt.Sprintf("conditional-origin-groups.%d.name", groupIndex) } value={ name } required maxlength="63"/>
			</label>
			<label for={ fmt.Sprintf("conditional-origin-groups.%d.condition", groupIndex) }>
				{{
					condition := ""
					if submittedGroup != nil {
						condition = submittedGroup.Condition
					} else if cloneGroup != nil && cloneGroup.Condition != nil {
						condition = *cloneGroup.Condition
					}
				}}
				Condition (VCL boolean expression, e.g. req.url ~ "^/api/")
				// Intentionally not `required`: editor.mjs hides this
				// textarea behind a CodeMirror instance and syncs its value
				// back into it on submit via a capture-phase listener. A
				// hidden-but-required empty control fails native constraint
				// validation un-focusably, silently aborting submit before
				// that sync listener runs. Emptiness is instead enforced
				// server-side, the same approach already used for
				// #vcl_template.
				<textarea
					id={ fmt.Sprintf("conditional-origin-groups.%d.condition", groupIndex) }
					name={ fmt.Sprintf("conditional-origin-groups.%d.condition", groupIndex) }
					class="condition-editor"
					rows="3"
					spellcheck="false"
				>{ condition }</textarea>
			</label>
			<div class="group-origins">
				// Prefer submitted data over clone data since this can be
				// modified contents based on a clone. Note a submitted group
				// with zero origins is left empty here (not backfilled with
				// a blank fieldset) since the form-level validator already
				// rejects it and will show the resulting error; the user is
				// meant to click "Add origin" to fix it up.
				if submittedGroup != nil {
					for i, submittedOrigin := range submittedGroup.Origins {
						@OriginFieldSet(originsNamePrefix, i, len(submittedGroup.Origins), &submittedOrigin, cdntypes.Origin{})
					}
				} else if cloneGroup != nil {
					if len(cloneOrigins) == 0 {
						@OriginFieldSet(originsNamePrefix, 0, 1, nil, cdntypes.Origin{})
					} else {
						for i, cloneOrigin := range cloneOrigins {
							@OriginFieldSet(originsNamePrefix, i, len(cloneOrigins), nil, cloneOrigin)
						}
					}
				} else {
					@OriginFieldSet(originsNamePrefix, 0, 1, nil, cdntypes.Origin{})
				}
			</div>
			@addGroupOriginButton(orgName, serviceName)
		</fieldset>
		<button
			type="button"
			class="move-up-button"
			disabled?={ groupIndex == 0 }
			_="on click put closest <article.origin-group/> before previous <article.origin-group/> then send manager:formchanged to #origin-group-fieldsets"
		>
			Move up
		</button>
		<button
			type="button"
			class="move-down-button"
			disabled?={ isLast }
			_="on click put closest <article.origin-group/> after next <article.origin-group/> then send manager:formchanged to #origin-group-fieldsets"
		>
			Move down
		</button>
		<button
			type="button"
			class="remove-group-button"
			_="on click
			set grp to closest <article.origin-group/>
			if window.__cdnEditorState
				call window.__cdnEditorState.destroyEditorsIn(grp)
			end
			remove grp
			send manager:formchanged to #origin-group-fieldsets"
		>
			Remove group
		</button>
	</article>
}

// DefaultOriginGroupFieldSet renders the pinned fallback origin group. It
// has no name/condition inputs and no move/remove controls: it is always
// present, always named "default" server-side, and always selected last.
// Its own htmx:afterSwap handler forwards to #origin-group-fieldsets'
// manager:formchanged listener since (unlike conditional groups) this
// fieldset lives outside that container so it never participates in the
// conditional-group renumbering.
templ DefaultOriginGroupFieldSet(orgName string, serviceName string, submittedOrigins []cdntypes.CreateServiceVersionOrigin, cloneOrigins []cdntypes.Origin) {
	<article id="default-origin-group-fieldset" _="on htmx:afterSwap send manager:formchanged to #origin-group-fieldsets">
		<fieldset>
			<legend>Default origin group (used when no condition matches)</legend>
			<div class="group-origins">
				if len(submittedOrigins) != 0 {
					for i, submittedOrigin := range submittedOrigins {
						@OriginFieldSet("default-origin-group.origins", i, len(submittedOrigins), &submittedOrigin, cdntypes.Origin{})
					}
				} else if len(cloneOrigins) != 0 {
					for i, cloneOrigin := range cloneOrigins {
						@OriginFieldSet("default-origin-group.origins", i, len(cloneOrigins), nil, cloneOrigin)
					}
				} else {
					@OriginFieldSet("default-origin-group.origins", 0, 1, nil, cdntypes.Origin{})
				}
			</div>
			@addDefaultGroupOriginButton(orgName, serviceName)
		</fieldset>
	</article>
}

// addOriginGroupButton renders the "Add origin group" button. Its "value"
// (sent as the next-group-index request parameter, since the button has a
// matching "name" attribute) is kept in sync live by the
// manager:formchanged handler in CreateServiceVersionContent.
templ addOriginGroupButton(orgName string, serviceName string, index string) {
	<button
		type="button"
		id="add-origin-group-button"
		hx-get="/console/new-origin-group-fieldset"
		hx-swap="beforeend"
		hx-target="#origin-group-fieldsets"
		hx-disabled-elt="this"
		name="next-group-index"
		hx-vals={ jsonAddButtonVals(orgName, serviceName) }
		value={ index }
	>
		Add origin group
	</button>
}

templ CreateServiceVersionContent(serviceName string, serviceID pgtype.UUID, orgName string, domains []cdntypes.Domain, submittedData *cdntypes.CreateServiceVersionForm, vclTemplateValue string, cloneData cdntypes.ServiceVersionCloneData, err error, errDetails string) {
	if err != nil {
		<article id="error-message" aria-label="Error" role="alert">
			switch  {
				case errors.Is(err, cdnerrors.ErrInvalidFormData):
					<div><strong>Error:</strong> Invalid form data</div>
				case errors.Is(err, cdnerrors.ErrInvalidVCL):
					<header>
						<strong>Error:</strong> Invalid VCL data
					</header>
					<pre>{ errDetails }</pre>
				case errors.Is(err, cdnerrors.ErrAlreadyExists):
					<div><strong>Duplication error:</strong> { err.Error() }</div>
				default:
					<div><strong>Error:</strong> Service version creation failed</div>
			}
		</article>
	}
	// hx-history="false" keeps htmx from caching this page's DOM in its
	// history snapshot: CodeMirror hides the textareas and mounts its own
	// editor DOM at runtime, so a restored snapshot would show stale or
	// broken editors. Back/forward re-requests the page from the server so
	// the editors are rebuilt from fresh markup.
	<form method="post" action={ templ.URL(fmt.Sprintf("/console/org/%s/create/service/version/%s", orgName, serviceID.String())) } hx-disabled-elt="find button[type='submit']" hx-boost="false" hx-history="false">
		<article>
			<fieldset>
				<legend>Domains</legend>
				if len(domains) == 0 {
					<div>No domains available</div>
				} else {
					for i, domain := range domains {
						if domain.Verified {
							<label for={ fmt.Sprintf("domains.%d", i) }>
								{ domain.FQDN }
								{{
									var precheck bool
									if submittedData != nil {
										for _, submittedDomain := range submittedData.Domains {
											if string(submittedDomain) == domain.FQDN {
												precheck = true
												break
											}
										}
									}
									for _, cloneDomain := range cloneData.Domains {
										if string(cloneDomain) == domain.FQDN {
											precheck = true
											break
										}
									}
								}}
								<input type="checkbox" id={ fmt.Sprintf("domains.%d", i) } name="domains" value={ domain.FQDN } checked?={ precheck }/>
							</label>
						}
					}
				}
			</fieldset>
		</article>
		{{
			descriptionValue := cloneData.Description
			if submittedData != nil {
				descriptionValue = submittedData.Description
			}
		}}
		<article>
			<fieldset>
				<legend>Description</legend>
				<input type="text" id="description" name="description" aria-label="Description" placeholder="Enter a description..." value={ descriptionValue } maxlength="512"/>
			</fieldset>
		</article>
		{{
			conditionalCloneGroups := conditionalOriginGroups(cloneData.OriginGroups)
			defaultCloneGroupID := defaultOriginGroupID(cloneData.OriginGroups)
		}}
		// The manager:formchanged handler below is the single source of
		// truth keeping every "conditional-origin-groups.N..." and
		// "...origins.M..." name (and id/for) attribute dense and in DOM
		// order after any add/remove/move, and keeping the "Add origin
		// group"/"Add origin" button counters and the move/remove disabled
		// states in sync. It fires on every htmx swap inside this
		// container (new group or new origin fieldsets) and is also sent
		// explicitly by the move/remove buttons' click handlers (which
		// mutate the DOM without an htmx swap).
		//
		// This matters because gorilla/schema does not require dense
		// indices when decoding indexed form fields: given e.g. only
		// "conditional-origin-groups.1.name" and
		// "conditional-origin-groups.2.name" (index 0 missing), it
		// silently produces a 3-element slice with a zero-value element at
		// index 0, rather than erroring (verified against the vendored
		// gorilla/schema v1.4.1 behavior). A zero-value group fails
		// server-side validation (name/condition/origins all
		// validate:"min=1"), so a renumbering bug here would surface as a
		// rejected submission rather than silently-wrong data - but dense
		// naming is still the invariant this handler exists to maintain.
		<div
			id="origin-group-fieldsets"
			_="
			on manager:formchanged
				make a RegExp from 'conditional-origin-groups\\.\\d+' called groupRE
				set groupCount to (<#origin-group-fieldsets > article.origin-group/>).length
				repeat for grp in <#origin-group-fieldsets > article.origin-group/> index gi
					set grp's @data-group-index to gi
					repeat in <[name]/> in grp
						set its @name to (its @name).replace(groupRE, `conditional-origin-groups.${gi}`)
					end
					repeat in <[id]/> in grp
						set its @id to (its @id).replace(groupRE, `conditional-origin-groups.${gi}`)
					end
					repeat in <[for]/> in grp
						set its @for to (its @for).replace(groupRE, `conditional-origin-groups.${gi}`)
					end
					if gi == 0
						repeat for btn in <button.move-up-button/> in grp
							add @disabled to btn
						end
					else
						repeat for btn in <button.move-up-button/> in grp
							remove @disabled from btn
						end
					end
					if gi == groupCount - 1
						repeat for btn in <button.move-down-button/> in grp
							add @disabled to btn
						end
					else
						repeat for btn in <button.move-down-button/> in grp
							remove @disabled from btn
						end
					end
				end
				make a RegExp from 'origins\\.\\d+\\.' called originRE
				repeat for container in <.group-origins/>
					set originCount to (<article.origin-fieldset/> in container).length
					repeat for org in <article.origin-fieldset/> in container index oi
						repeat in <[name]/> in org
							set its @name to (its @name).replace(originRE, `origins.${oi}.`)
						end
						repeat in <[id]/> in org
							set its @id to (its @id).replace(originRE, `origins.${oi}.`)
						end
						repeat in <[for]/> in org
							set its @for to (its @for).replace(originRE, `origins.${oi}.`)
						end
						if originCount == 1
							repeat for btn in <button.remove-origin-button/> in org
								add @disabled to btn
							end
						else
							repeat for btn in <button.remove-origin-button/> in org
								remove @disabled from btn
							end
						end
					end
				end
				set #add-origin-group-button @value to groupCount
			on htmx:afterSwap
				send manager:formchanged to me
			"
		>
			if submittedData != nil {
				for i, submittedGroup := range submittedData.ConditionalGroups {
					@OriginGroupFieldSet(orgName, serviceName, i, i == len(submittedData.ConditionalGroups)-1, &submittedGroup, nil, nil)
				}
			} else {
				for i, cloneGroup := range conditionalCloneGroups {
					@OriginGroupFieldSet(orgName, serviceName, i, i == len(conditionalCloneGroups)-1, nil, &cloneGroup, originsForGroup(cloneData.Origins, cloneGroup.ID))
				}
			}
		</div>
		{{
			var nextGroupIndexStr string
			if submittedData != nil {
				nextGroupIndexStr = strconv.Itoa(len(submittedData.ConditionalGroups))
			} else {
				nextGroupIndexStr = strconv.Itoa(len(conditionalCloneGroups))
			}
		}}
		@addOriginGroupButton(orgName, serviceName, nextGroupIndexStr)
		{{
			var submittedDefaultOrigins []cdntypes.CreateServiceVersionOrigin
			if submittedData != nil {
				submittedDefaultOrigins = submittedData.DefaultGroup.Origins
			}
			cloneDefaultOrigins := originsForGroup(cloneData.Origins, defaultCloneGroupID)
		}}
		@DefaultOriginGroupFieldSet(orgName, serviceName, submittedDefaultOrigins, cloneDefaultOrigins)
		{{
			displayValue := vclTemplateValue
			if submittedData != nil {
				displayValue = submittedData.VCLTemplate
			}
		}}
		<article>
			<fieldset>
				<legend>VCL template</legend>
				<small id="vcl-hint" class="vcl-hint">Loading enhanced editor...</small>
				<div>
					<label id="vcl-template-label" for="vcl_template">vcl_template</label>
					<textarea
						id="vcl_template"
						name="vcl_template"
						placeholder="Enter your VCL template here..."
						class="vcl-editor"
						rows="24"
						maxlength="1048576"
						spellcheck="false"
						aria-describedby="vcl-hint"
					>{ displayValue }</textarea>
				</div>
			</fieldset>
		</article>
		<button type="submit">Add service version</button>
	</form>
	<script defer src="/js/dist/codemirror/editor.bundle.min.js" onerror="document.getElementById('vcl-hint').textContent = 'Enhanced editor failed to load. Basic editing is still available.'"></script>
}

templ ActivateServiceVersionContent(orgName string, serviceName string, serviceID pgtype.UUID, version int64, err error) {
	<div>You are about to activate { serviceName } version { strconv.FormatInt(version, 10) }, are you sure?</div>
	<form method="post" action={ templ.URL(fmt.Sprintf("/console/org/%s/services/%s/%d/activate", orgName, serviceID.String(), version)) } hx-disabled-elt="find button[type='submit']">
		<label for="confirmation">
			Yes I am sure
			<input type="checkbox" id="confirmation" name="confirmation" required/>
		</label>
		<button type="submit">Activate version</button>
		<a href={ templ.URL(fmt.Sprintf("/console/org/%s/services/%s", orgName, serviceName)) } role="button" class="secondary">Cancel</a>
	</form>
	if err != nil {
		<div>Service version activation failed</div>
	}
}

templ DisableServiceContent(orgName string, serviceName string, serviceID string, ipAddresses []netip.Addr, err error) {
	<div>
		<p>
			You are about to disable <strong>{ serviceName }</strong>.
		</p>
		<p>
			This stops the service on all cache nodes, withdraws its address
			announcements, and permanently clears its cache. It will return cold and
			may be briefly unavailable while cache nodes start again.
		</p>
		<p>
			Configuration, versions, IP addresses and UID range are all kept, and the
			service still counts against your service quota. Disabling does not free
			a slot for a new service. You can enable it again at any time.
		</p>
		if len(ipAddresses) > 0 {
			<p>Addresses that stay reserved for this service:</p>
			<ul>
				for _, addr := range ipAddresses {
					<li><code>{ addr.String() }</code></li>
				}
			</ul>
		}
	</div>
	// Action keyed on the immutable id, a stale page must not be able to
	// disable a same-named replacement version.
	<form method="post" action={ templ.URL(fmt.Sprintf("/console/org/%s/services/%s/disable", orgName, serviceID)) } hx-disabled-elt="find button[type='submit']">
		<label for="confirmation">
			Yes, disable this service
			<input type="checkbox" id="confirmation" name="confirmation" required/>
		</label>
		<button type="submit" class="destructive">Disable service</button>
		// Cancel targets exactly where the handler already redirects an
		// unconfirmed POST, so backing out is a deliberate affordance rather
		// than "submit without ticking the box".
		<a href={ templ.URL(fmt.Sprintf("/console/org/%s/services", orgName)) } role="button" class="secondary">Cancel</a>
	</form>
	if err != nil {
		<div class="error-text" role="alert">Disabling the service failed</div>
	}
}

templ LoginPage(loginFailed bool) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			@commonHead()
			@picoCssLinks()
			// Configure the grid layout of the login page
			<link rel="stylesheet" href="/css/login-grid.css"/>
			<title>SUNET CDN Manager Login</title>
		</head>
		<body>
			<div class="login-container">
				<div class="login-title">
					<h1>SUNET CDN Manager</h1>
				</div>
				<div class="login-form">
					<a href={ templ.URL("/auth/oidc/keycloak") } role="button">Login with Swamid</a>
					<div class="login-separator">or</div>
					<h2>Local</h2>
					if loginFailed {
						<div class="login-error" role="alert">Login failed!</div>
					}
					<form method="post" action={ templ.URL(cdntypes.AuthLoginPath) }>
						<label for="username">
							Username
							<input type="text" id="username" name="username" required/>
						</label>
						<label for="password">
							Password
							<input type="password" id="password" name="password" required/>
						</label>
						<button type="submit">Login</button>
					</form>
				</div>
			</div>
		</body>
	</html>
}

templ CacheNodesContent(nodes []cdntypes.CacheNodeListItem, nodeGroups []cdntypes.NodeGroup, flashMessages []string, errorMessage string) {
	@flashMessagesComponent(flashMessages)
	if errorMessage != "" {
		<span class="error-text" role="alert" aria-live="polite">{ errorMessage }</span>
	}
	if len(nodes) == 0 {
		<article class="empty-state">
			<p>No cache nodes added yet</p>
			<a href="/console/superuser/create/cache-node" role="button">Add your first cache node</a>
		</article>
	} else {
		<table>
			<thead>
				<tr>
					<th>Name</th>
					<th>Description</th>
					<th>Addresses</th>
					<th>Maintenance</th>
					<th>Node group</th>
					<th>Actions</th>
				</tr>
			</thead>
			<tbody>
				for _, node := range nodes {
					<tr>
						<td>{ node.Name }</td>
						<td>{ node.Description }</td>
						<td class="addresses">
							for _, addr := range node.Addresses {
								<div><code>{ addr.String() }</code></div>
							}
						</td>
						<td>
							@checkboxInput(
								"maintenance",
								node.Maintenance,
								fmt.Sprintf("/console/superuser/cache-nodes/%s/maintenance", node.Name),
								fmt.Sprintf("Toggle maintenance for '%s'?", node.Name),
								fmt.Sprintf("Toggle maintenance for '%s'", node.Name),
							)
						</td>
						<td>
							@selectInput(
								"node-group",
								fmt.Sprintf("/console/superuser/cache-nodes/%s/node-group", node.Name),
								fmt.Sprintf("Change node group for '%s' to '{value}'?", node.Name),
								fmt.Sprintf("Select node group for '%s'", node.Name),
								nodeGroupToOptions(node.NodeGroupID, node.NodeGroupName, nodeGroups),
							)
						</td>
						<td>
							<a href={ templ.URL(fmt.Sprintf("/console/superuser/cache-nodes/%s/edit", node.Name)) } role="button" class="secondary">Edit</a>
							<button
								type="button"
								hx-delete={ string(templ.URL(fmt.Sprintf("/console/superuser/cache-nodes/%s", node.Name))) }
								hx-target="body"
								hx-confirm={ fmt.Sprintf("Are you sure you want to delete '%s'?", node.Name) }
								hx-disabled-elt="this"
							>
								Delete
							</button>
						</td>
					</tr>
				}
			</tbody>
		</table>
		<p>
			<a href="/console/superuser/create/cache-node" role="button">Add cache node</a>
		</p>
	}
}

templ CreateCacheNodeContent(formData CacheNodeFormData) {
	if formData.Errors.ServerError != "" {
		<span class="error-text" role="alert" aria-live="polite">{ formData.Errors.ServerError }</span>
	}
	<form method="post" action="/console/superuser/create/cache-node" hx-disabled-elt="find button[type='submit']">
		<label for="name">
			Name
			<input type="text" id="name" name="name" placeholder="Enter cache node name..." value={ formData.Name } required/>
		</label>
		<span class="error-text">{ formData.Errors.Name }</span>
		<label for="description">
			Description
			<input type="text" id="description" name="description" placeholder="Enter description..." value={ formData.Description } required/>
		</label>
		<span class="error-text">{ formData.Errors.Description }</span>
		<label for="addresses">
			Addresses (one per line, IPv4 and/or IPv6)
			<textarea id="addresses" name="addresses" placeholder="192.0.2.1&#10;2001:db8::1" rows="4">{ formData.Addresses }</textarea>
		</label>
		<span class="error-text">{ formData.Errors.Addresses }</span>
		<button type="submit">Add cache node</button>
	</form>
}

