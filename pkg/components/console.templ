		<span class="error-text" role="alert" aria-live="polite">{ formData.Errors.ServerError }</span>
	}
	<form method="post" action={ templ.URL(fmt.Sprintf("/console/superuser/orgs/%s/edit", orgName)) } hx-disabled-elt="find button[type='submit']">
		<label for="name">
			Name
			<input type="text" id="name" name="name" placeholder="Enter organization name..." value={ formData.Name } required/>
		</label>
		<span class="error-text">{ formData.Errors.Name }</span>
		<label for="service-quota">
			Service quota
			<input type="number" id="service-quota" name="service-quota" min="0" value={ formData.ServiceQuota } required/>
		</label>
		<span class="error-text">{ formData.Errors.ServiceQuota }</span>
		<label for="domain-quota">
			Domain quota
			<input type="number" id="domain-quota" name="domain-quota" min="0" value={ formData.DomainQuota } required/>
		</label>
		<span class="error-text">{ formData.Errors.DomainQuota }</span>
		<label for="client-token-quota">
			Client token quota
			<input type="number" id="client-token-quota" name="client-token-quota" min="0" value={ formData.ClientTokenQuota } required/>
		</label>
		<span class="error-text">{ formData.Errors.ClientTokenQuota }</span>
		<button type="submit">Save changes</button>
	</form>
}

templ ConsoleErrorContent(errorMessage string) {
	<article aria-label="Error">
		<span class="error-text" role="alert" aria-live="polite">{ errorMessage }</span>
	</article>
}

templ UsersContent(users []cdntypes.UserListItem, flashMessages []string, errorMessage string) {
	@flashMessagesComponent(flashMessages)
	if errorMessage != "" {
		<span class="error-text" role="alert" aria-live="polite">{ errorMessage }</span>
	}
	if len(users) == 0 {
		<article class="empty-state">
			<p>No users added yet</p>
			<a href="/console/superuser/create/user" role="button">Add your first user</a>
		</article>
	} else {
		<table>
			<thead>
				<tr>
					<th>Display name</th>
					<th>Role</th>
					<th>Organization</th>
					<th>Auth Provider</th>
					<th>Actions</th>
				</tr>
			</thead>
			<tbody>
				for _, user := range users {
					<tr>
						<td>{ user.DisplayName }</td>
						<td>{ user.RoleName }</td>
						<td>
							if user.OrgName != nil {
								{ *user.OrgName }
							} else {
								—
							}
						</td>
						<td>{ user.AuthProvider }</td>
						<td>
							<a href={ templ.URL(fmt.Sprintf("/console/superuser/users/%s/edit", user.ID.String())) } role="button" class="secondary">Edit</a>
							<button
								type="button"
								hx-delete={ string(templ.URL(fmt.Sprintf("/console/superuser/users/%s", user.ID.String()))) }
								hx-target="body"
								hx-confirm={ fmt.Sprintf("Are you sure you want to delete user '%s'?", user.DisplayName) }
								hx-disabled-elt="this"
							>
								Delete
							</button>
						</td>
					</tr>
				}
			</tbody>
		</table>
		<p>
			<a href="/console/superuser/create/user" role="button">Add user</a>
		</p>
	}
}

templ CreateUserContent(formData UserFormData, roles []cdntypes.Role, orgs []cdntypes.Org) {
	if formData.Errors.ServerError != "" {
		<span class="error-text" role="alert" aria-live="polite">{ formData.Errors.ServerError }</span>
	}
	<form method="post" action="/console/superuser/create/user" hx-disabled-elt="find button[type='submit']">
		<label for="display_name">
			Display name
			<input type="text" id="display_name" name="display_name" placeholder="Enter display name..." value={ formData.DisplayName } required/>
		</label>
		<span class="error-text">{ formData.Errors.DisplayName }</span>
		<label for="role">
			Role
			<select id="role" name="role" required>
				for _, role := range roles {
					<option value={ role.Name } selected?={ role.Name == formData.Role }>{ role.Name }</option>
				}
			</select>
		</label>
		<span class="error-text">{ formData.Errors.Role }</span>
		<label for="org">
			Organization
			<select id="org" name="org">
				<option value={ cdntypes.OrgNotSelected } selected?={ formData.Org == "" || formData.Org == cdntypes.OrgNotSelected }>{ cdntypes.OrgNotSelected }</option>
				for _, org := range orgs {
					<option value={ org.Name } selected?={ org.Name == formData.Org }>{ org.Name }</option>
				}
			</select>
		</label>
		<span class="error-text">{ formData.Errors.Org }</span>
		<label for="password">
			Password
			<input type="password" id="password" name="password" placeholder="Enter password (min 15 characters)..." required/>
		</label>
		<span class="error-text">{ formData.Errors.Password }</span>
		<label for="confirm-password">
			Confirm password
			<input type="password" id="confirm-password" name="confirm-password" placeholder="Confirm password..." required/>
		</label>
		<span class="error-text">{ formData.Errors.ConfirmPassword }</span>
		<button type="submit">Add user</button>
	</form>
}

templ EditUserContent(formData UserFormData, roles []cdntypes.Role, orgs []cdntypes.Org, authProvider string, userID string, passwordResetData PasswordResetFormData) {
	if formData.Errors.ServerError != "" {
		<span class="error-text" role="alert" aria-live="polite">{ formData.Errors.ServerError }</span>
	}
	<form method="post" action={ templ.URL(fmt.Sprintf("/console/superuser/users/%s/edit", userID)) } hx-disabled-elt="find button[type='submit']">
		<label for="display_name">
			Display name
			if authProvider != cdntypes.LocalAuthProvider {
				<input type="text" id="display_name" name="display_name" value={ formData.DisplayName } readonly/>
			} else {
				<input type="text" id="display_name" name="display_name" placeholder="Enter display name..." value={ formData.DisplayName } required/>
			}
		</label>
		<span class="error-text">{ formData.Errors.DisplayName }</span>
		<label for="role">
			Role
			<select id="role" name="role" required>
				for _, role := range roles {
					<option value={ role.Name } selected?={ role.Name == formData.Role }>{ role.Name }</option>
				}
			</select>
		</label>
		<span class="error-text">{ formData.Errors.Role }</span>
		<label for="org">
			Organization
			<select id="org" name="org">
				<option value={ cdntypes.OrgNotSelected } selected?={ formData.Org == "" || formData.Org == cdntypes.OrgNotSelected }>{ cdntypes.OrgNotSelected }</option>
				for _, org := range orgs {
					<option value={ org.Name } selected?={ org.Name == formData.Org }>{ org.Name }</option>
				}
			</select>
		</label>
		<span class="error-text">{ formData.Errors.Org }</span>
		<label>
			Auth Provider
			<input type="text" value={ authProvider } readonly/>
		</label>
		<button type="submit">Save changes</button>
	</form>
	if authProvider == cdntypes.LocalAuthProvider {
		<hr/>
		<h3>Reset Password</h3>
		if passwordResetData.Errors.ServerError != "" {
			<span class="error-text" role="alert" aria-live="polite">{ passwordResetData.Errors.ServerError }</span>
		}
		<form method="post" action={ templ.URL(fmt.Sprintf("/console/superuser/users/%s/reset-password", userID)) } hx-disabled-elt="find button[type='submit']">
			<label for="password">
				New password
				<input type="password" id="password" name="password" placeholder="Enter new password (min 15 characters)..." required/>
			</label>
			<span class="error-text">{ passwordResetData.Errors.Password }</span>
			<label for="confirm-password">
				Confirm password
				<input type="password" id="confirm-password" name="confirm-password" placeholder="Confirm new password..." required/>
			</label>
			<span class="error-text">{ passwordResetData.Errors.ConfirmPassword }</span>
			<button type="submit">Reset password</button>
		</form>
	}
}
